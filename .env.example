# Copy this file to .env and fill in your values

# LLM Provider (choose one: openai, google, anthropic)
LLM_PROVIDER=google
LLM_MODEL=gemini-3.5-flash-lite

# API Keys — fill in ONE provider
OPENAI_API_KEY=your_openai_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# PubMed (use your real email)
PUBMED_EMAIL=your_email@example.com

# Semantic Scholar (optional)
SEMANTIC_SCHOLAR_API_KEY=

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=healthcare_papers

# PostgreSQL
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/healthcare_la

# Embeddings
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_PROVIDER=sentence_transformers

# App
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true
LOG_LEVEL=INFO
